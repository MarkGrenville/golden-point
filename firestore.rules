rules_version = '2';

// All authoritative mutations go through server code using the Admin SDK, which checks
// workspace membership explicitly. Clients may only read public projections and their own
// records. Nothing is client-writable.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    // Public, deliberately limited projections: names, places, results.
    match /publicGroups/{slug} { allow read: if true; }
    match /publicEvents/{eventId} { allow read: if true; }
    match /publicScoreboards/{id} { allow read: if true; }

    // A player's own bookings and notifications (for live status updates).
    match /registrations/{id} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
    }
    match /notifications/{id} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Members can read their workspace membership record; nothing else in the workspace.
    match /workspaces/{wid}/members/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
    }

    // Everything else — merchants, payments, audit, private events, contacts —
    // is server-only.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
