{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "apphosting": [
    {
      "backendId": "golden-point-web",
      "rootDir": "/",
      "ignore": ["node_modules", ".git", "functions", ".emulator-data"]
    }
  ],
  "emulators": {
    "auth": {
      "port": 9410
    },
    "firestore": {
      "port": 8180
    },
    "ui": {
      "enabled": true,
      "port": 4410
    },
    "hub": {
      "port": 4411
    },
    "logging": {
      "port": 4412
    },
    "singleProjectMode": true
  }
}
